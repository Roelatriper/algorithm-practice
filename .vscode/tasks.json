{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build current C++ file",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build.sh",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build current C++ file for debugging",
            "type": "process",
            "command": "${workspaceFolder}/scripts/build-debug.sh",
            "args": ["${file}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
