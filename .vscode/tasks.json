{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build current file",   // 任务名称
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-stdlib=libc++",
                "-g",                // 生成调试信息（必须）
                "${file}",           // 当前打开的 .cpp 文件
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"  // 生成同名的可执行文件（无后缀）
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}